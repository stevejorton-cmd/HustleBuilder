{
  "functions": {
    "api/handler.js": {
      "maxDuration": 60,
      "includeFiles": "host/demo/*.html"
    }
  },
  "redirects": [
    {
      "source": "/(host|tests|stress|scripts|node_modules)/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(package\\.json|package-lock\\.json|vercel\\.json|booking-inbox-script-template\\.gs\\.txt)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    },
    {
      "source": "/parents",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/handler?hbpath=admin"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/handler?hbpath=admin/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/handler?hbpath=$1"
    },
    {
      "source": "/parents",
      "destination": "/index.html"
    },
    {
      "source": "/calendar/subscribe/:token",
      "destination": "/api/handler?hbpath=calendar/subscribe/:token"
    },
    {
      "source": "/((?!api/|icons/|manifest\\.webmanifest|sw\\.js)[^/]+)",
      "destination": "/api/handler?hbsite=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/renewals",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/mail",
      "schedule": "0 * * * *"
    }
  ]
}
