{
  "functions": {
    "api/handler.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/(host|tests|stress|scripts|node_modules)/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(package\\.json|package-lock\\.json|vercel\\.json|booking-inbox-script-template\\.gs\\.txt)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/handler?hbpath=admin"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/handler?hbpath=admin/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/handler?hbpath=$1"
    },
    {
      "source": "/parents",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|icons/|manifest\\.webmanifest|sw\\.js)[^/]+)",
      "destination": "/api/handler?hbsite=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/renewals",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/mail",
      "schedule": "*/5 * * * *"
    }
  ]
}
