# Copy to .env.local for local work, or set these in the host's dashboard.
# Never commit real values. `npm run preflight` checks the production set.

# --- Required in production -------------------------------------------------
DATABASE_URL=                 # pooled PostgreSQL URL, TLS on
STRIPE_SECRET_KEY=            # sk_live_... (sk_test_... on previews)
STRIPE_WEBHOOK_SECRET=        # whsec_... for /api/stripe/webhook
RESEND_API_KEY=
BOOKING_FROM=                 # "Hustle Builder <bookings@your-domain>"
ADMIN_SECRET=                 # long random string; the /admin password
CRON_SECRET=                  # long random string; Vercel sends it to the crons
PUBLIC_ORIGIN=                # https://hustlebuilder.org  (no trailing slash)
PUBLISH_TEST_MODE=0           # 1 shows sign-in codes on screen and sends no mail
PAYWALL_MODE=stripe

# --- Optional ---------------------------------------------------------------
REPLY_TO=                     # mailbox a person reads
ALLOWED_ORIGINS=              # extra browser origins, comma separated
TRIAL_DAYS=                   # default 14
HB_MAINTENANCE_MODE=          # 1 = every request answers 503

# --- Tools only -------------------------------------------------------------
HB_BACKUP_KEY=                # 32-byte base64 key for scripts/backup.mjs
HB_TEST_DATABASE_URL=         # isolated database for `npm run test:postgres`
BLOB_READ_WRITE_TOKEN=        # only to read the old Blob store
